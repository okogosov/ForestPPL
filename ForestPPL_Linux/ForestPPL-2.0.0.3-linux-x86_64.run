#!/usr/bin/env bash
# ============================================================================
#  ForestPPL 2.0.0.3 -- self-extracting installer for Linux x86_64
#
#  Run:   bash ForestPPL-2.0.0.3-linux-x86_64.run            (install into ~/ForestPPL)
#         bash ForestPPL-2.0.0.3-linux-x86_64.run --help     (all options)
#
#  Everything below the __PAYLOAD_BELOW__ line is a gzip-compressed tar
#  archive; this script only checks the system, verifies the archive and
#  unpacks it. Nothing is downloaded, no sudo is needed for a per-user install.
# ============================================================================
set -u

VERSION="2.0.0.3"
PAYLOAD_SHA256="0f0feb78abf6db983d3cbc16fae31bd29c005af01e4e4e0402c0347b233bb5c9"
PAYLOAD_SIZE_KB="3610"
MIN_GLIBC="2.38"

TARGET="$HOME/ForestPPL"
MAKE_LINKS=1
ASSUME_YES=0
MODE=install

say()  { printf '%s\n' "$*"; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
cat <<EOF
ForestPPL $VERSION installer (Linux x86_64)

Usage: bash $(basename "$0") [options]

  --target DIR     install into DIR            (default: ~/ForestPPL)
  --no-links       do not create the 'forest' / 'forest-codegen' commands
  -y, --yes        do not ask questions (upgrade/overwrite without prompt)
  --check          only verify the system and the archive integrity
  --list           list the files inside the archive
  --extract DIR    only unpack the files into DIR (no checks, no links)
  -h, --help       this help

After installation:
  forest                       interactive ForestPPL
  forest script.scr            run a script (from any folder)
  forest-codegen MyLib.cfg     generate a new plugin skeleton
  ~/ForestPPL/RunAll.sh        run the full example/test suite -> Log.txt
  ~/ForestPPL/uninstall.sh     remove ForestPPL
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --target)   [ $# -ge 2 ] || die "--target needs a directory"; TARGET="$2"; shift 2 ;;
    --target=*) TARGET="${1#*=}"; shift ;;
    --no-links) MAKE_LINKS=0; shift ;;
    -y|--yes)   ASSUME_YES=1; shift ;;
    --check)    MODE=check; shift ;;
    --list)     MODE=list; shift ;;
    --extract)  [ $# -ge 2 ] || die "--extract needs a directory"; MODE=extract; TARGET="$2"; shift 2 ;;
    -h|--help)  usage; exit 0 ;;
    *)          usage; die "unknown option: $1" ;;
  esac
done

SELF="$(readlink -f "$0")"
payload_line() { awk '/^__PAYLOAD_BELOW__$/ { print NR + 1; exit }' "$SELF"; }
PAYLOAD_LINE="$(payload_line)"
[ -n "$PAYLOAD_LINE" ] || die "installer is damaged (payload marker not found)"
payload() { tail -n +"$PAYLOAD_LINE" "$SELF"; }

for tool in tar gzip awk tail readlink; do
  command -v "$tool" >/dev/null 2>&1 || die "'$tool' is required but not installed"
done

verify_payload() {
  if command -v sha256sum >/dev/null 2>&1; then
    local got
    got="$(payload | sha256sum | awk '{print $1}')"
    [ "$got" = "$PAYLOAD_SHA256" ] || die "archive is corrupted (checksum mismatch). Download the installer again.
       Tip: copy the .run file in binary mode; do not open/save it in a text editor."
    say "  archive integrity ........ OK (sha256)"
  else
    payload | gzip -t 2>/dev/null || die "archive is corrupted. Download the installer again."
    say "  archive integrity ........ OK (gzip test; sha256sum not available)"
  fi
}

version_ge() {  # version_ge A B  -> true if A >= B
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]
}

check_system() {
  local arch glibc
  arch="$(uname -m)"
  [ "$arch" = "x86_64" ] || die "this build is for x86_64, this machine is '$arch'"
  say "  architecture ............. $arch OK"

  glibc="$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')"
  [ -n "$glibc" ] || glibc="$(ldd --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | tail -1)"
  if [ -z "$glibc" ]; then
    die "glibc not found (musl-based systems such as Alpine are not supported)"
  fi
  version_ge "$glibc" "$MIN_GLIBC" || die "glibc $glibc is too old, ForestPPL needs glibc >= $MIN_GLIBC
       (Ubuntu 24.04+, Debian 13+, Fedora 39+, Linux Mint 22+ ...).
       On WSL: install Ubuntu 24.04 from the Microsoft Store ('wsl --install -d Ubuntu-24.04')."
  say "  glibc .................... $glibc OK (>= $MIN_GLIBC)"
  # libstdc++ / libgcc_s are bundled in lib/, so no compiler or runtime
  # packages are needed on the target system.
}

case "$MODE" in
  list)    payload | tar -tzf - ; exit $? ;;
  extract)
    mkdir -p "$TARGET" || die "cannot create $TARGET"
    payload | tar -xzf - -C "$TARGET" --strip-components=1 || die "unpacking failed"
    say "Unpacked into $TARGET"; exit 0 ;;
esac

say "ForestPPL $VERSION installer"
say ""
say "Checking:"
check_system
verify_payload
if [ "$MODE" = check ]; then say ""; say "All checks passed."; exit 0; fi

# ---------------------------------------------------------------------------
TARGET="$(readlink -m "$TARGET")"
case "$TARGET" in
  /mnt/[a-z]/*|/mnt/[a-z])
    say ""
    say "WARNING: $TARGET is a Windows drive mounted into WSL."
    say "         It works, but is much slower and file names there are case-INsensitive."
    say "         Recommended: a Linux folder, e.g. ~/ForestPPL (the default)."
    if [ "$ASSUME_YES" -eq 0 ]; then
      read -r -p "Install there anyway? [y/N] " a; case "$a" in y|Y|yes|Ð´|Ð”|Ð´Ð°) ;; *) say "Cancelled."; exit 0 ;; esac
    fi ;;
esac

BACKUP=""
if [ -e "$TARGET" ]; then
  if [ -f "$TARGET/.forestppl-install" ]; then
    old="$(cat "$TARGET/.forestppl-install" 2>/dev/null | head -1)"
    say ""
    say "ForestPPL is already installed in $TARGET ($old)."
    say "It will be upgraded to $VERSION. The old folder is kept as a backup;"
    say "your Configuration.data, Log/ and Log.txt are carried over."
    if [ "$ASSUME_YES" -eq 0 ]; then
      read -r -p "Continue? [Y/n] " a; case "$a" in n|N|no|Ð½|Ð|Ð½ÐµÑ‚) say "Cancelled."; exit 0 ;; esac
    fi
    BACKUP="$TARGET.bak-$(date +%Y%m%d-%H%M%S)"
    mv "$TARGET" "$BACKUP" || die "cannot move old installation to $BACKUP"
  elif [ -n "$(ls -A "$TARGET" 2>/dev/null)" ]; then
    die "$TARGET exists and is not empty (and is not a ForestPPL installation).
       Choose another folder with --target DIR."
  fi
fi

mkdir -p "$TARGET" || die "cannot create $TARGET (for a system-wide folder like /opt use sudo)"
say ""
say "Installing into $TARGET ..."
if ! payload | tar -xzf - -C "$TARGET" --strip-components=1 --no-same-owner; then
  rm -rf "$TARGET"
  [ -n "$BACKUP" ] && mv "$BACKUP" "$TARGET"
  die "unpacking failed; nothing was changed"
fi

if [ -n "$BACKUP" ]; then
  if [ -f "$BACKUP/Configuration.data" ] && ! cmp -s "$BACKUP/Configuration.data" "$TARGET/Configuration.data"; then
    mv "$TARGET/Configuration.data" "$TARGET/Configuration.data.new"
    cp -p "$BACKUP/Configuration.data" "$TARGET/Configuration.data"
    say "  kept your Configuration.data (the new default is Configuration.data.new)"
  fi
  [ -d "$BACKUP/Log" ] && cp -rp "$BACKUP/Log/." "$TARGET/Log/" 2>/dev/null
  [ -f "$BACKUP/Log.txt" ] && cp -p "$BACKUP/Log.txt" "$TARGET/Log.txt"
fi

printf '%s\n' "$VERSION" "installed $(date '+%Y-%m-%d %H:%M:%S') by $(id -un)" > "$TARGET/.forestppl-install"
: > "$TARGET/.forestppl-links"

# ---------------------------------------------------------------------------
# Commands: ~/.local/bin for a normal user, /usr/local/bin when run as root.
if [ "$MAKE_LINKS" -eq 1 ]; then
  if [ "$(id -u)" -eq 0 ]; then BIN="/usr/local/bin"; else BIN="$HOME/.local/bin"; fi
  mkdir -p "$BIN" 2>/dev/null
  for pair in "forest:forest" "forest-codegen:CodeGen"; do
    name="${pair%%:*}"; tgt="${pair#*:}"
    if [ -e "$BIN/$name" ] && [ ! -L "$BIN/$name" ]; then
      say "  WARNING: $BIN/$name exists and is not a link -- not touched"
      continue
    fi
    if ln -sfn "$TARGET/$tgt" "$BIN/$name" 2>/dev/null; then
      printf '%s\n' "$BIN/$name" >> "$TARGET/.forestppl-links"
      say "  command '$name' -> $BIN/$name"
    else
      say "  WARNING: could not create $BIN/$name"
    fi
  done
  case ":$PATH:" in
    *":$BIN:"*) ;;
    *) say ""
       say "  NOTE: $BIN is not in your PATH yet. Open a new terminal"
       say "        (Ubuntu adds ~/.local/bin automatically once it exists), or run:"
       say "          echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.bashrc && source ~/.bashrc" ;;
  esac
fi

# ---------------------------------------------------------------------------
say ""
say "Self-test ..."
if out="$(cd "$TARGET" && printf 'exit\n' | timeout 20 ./Forest 2>&1)" && printf '%s' "$out" | grep -q "ForestPPL is ended"; then
  say "  Forest starts ............ OK"
else
  say "  WARNING: Forest did not start correctly. Output:"
  printf '%s\n' "$out" | tail -15
fi
if printf '%s' "$out" | grep -q "Error: \[FuncImport\]"; then
  say "  WARNING: some plugins failed to load:"
  printf '%s\n' "$out" | grep "Error: \[FuncImport\]"
fi

say ""
say "ForestPPL $VERSION installed in $TARGET"
[ -n "$BACKUP" ] && say "Previous installation kept in $BACKUP (delete it when no longer needed)"
say ""
say "  forest                    interactive mode"
say "  forest script.scr         run a script"
say "  forest-codegen X.cfg      generate a plugin skeleton"
say "  $TARGET/RunAll.sh    full test run -> Log.txt"
say "  $TARGET/uninstall.sh uninstall"
exit 0
__PAYLOAD_BELOW__
